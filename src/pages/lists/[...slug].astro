---
import { getCollection, getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export async function getStaticPaths() {
	const entries = await getCollection("lists");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { id: entry.id },
	}));
}

const { id } = Astro.props;
const entry = await getEntry("lists", id);
if (!entry) {
	throw new Error(`List page not found: ${id}`);
}
const { Content } = await render(entry);

const headingMatch = entry.body?.match(/^#\s+(.+)$/m);
const title = headingMatch ? headingMatch[1] : id;
---

<MainGridLayout title={title} description={title}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
